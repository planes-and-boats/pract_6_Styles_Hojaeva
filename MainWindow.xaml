<Window x:Class="pract_6_Hojaeva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pract_6_Hojaeva"
        mc:Ignorable="d" Background="{DynamicResource WindowBackground}"
        Title="Погодная станция" Height="850" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Menu Grid.Row="0">
            <MenuItem Header="Настройки">
                <MenuItem Header="Сменить тему" Click="ChangeTheme_Click"/>
            </MenuItem>
        </Menu>

        <TextBlock Grid.Row="1"
                   Text="Погода"
                   Style="{StaticResource HeaderTextBlockStyle}"/>

        <StackPanel Grid.Row="2" Style="{StaticResource ContentStackPanelStyle}">
            <TextBlock Style="{StaticResource ContentTextBlockStyle}" Text="Переключатели отображения данных"/>

            <WrapPanel Orientation="Horizontal">
                <RadioButton Content="Данные 1"/>
                <RadioButton Content="Данные 2"/>
                <RadioButton Content="Данные 3"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="3" Style="{StaticResource ContentStackPanelStyle}">
            <TextBlock Style="{StaticResource ContentTextBlockStyle}" Text="Стандартные процедуры"/>

            <WrapPanel
                Orientation="Horizontal"
                VerticalAlignment="Top">
                <Button Content="Стандартная кнопка"/>
                <Button Style="{StaticResource MinorButton}" Content="Второстепенная кнопка"/>
                <Button Style="{StaticResource DangerButton}" Content="Опасная кнопка"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Style="{StaticResource ContentStackPanelStyle}">
            <TextBlock Text="Индикатор показаний" Style="{StaticResource ContentTextBlockStyle}"/>

            <ProgressBar/>
        </StackPanel>

        <StackPanel Grid.Row="5" Style="{StaticResource ContentStackPanelStyle}">
            <TextBlock Style="{StaticResource ContentTextBlockStyle}" Text="Выбор датчика"/>

            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Датчик 1"/>
                <CheckBox Content="Датчик 2"/>
                <CheckBox Content="Датчик 3"/>
                <CheckBox Content="Датчик 4"/>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="6" Style="{StaticResource ContentStackPanelStyle}">
            <TextBlock Style="{StaticResource ContentTextBlockStyle}" Text="Выбор вид прогноза"/>

            <ComboBox>
                <ComboBoxItem Content="Авиационный"/>
                <ComboBoxItem Content="Морской"/>
                <ComboBoxItem Content="Агропромышленный"/>
                <ComboBoxItem Content="Медицинский"/>
                <ComboBoxItem Content="Штормовое предупреждение"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="7" Style="{StaticResource ContentStackPanelStyle}">
            <TextBlock Style="{StaticResource ContentTextBlockStyle}" Text="Введите прогноз"/>

            <TextBox Style="{StaticResource MultilineTextBox}"/>

            <TextBlock Style="{StaticResource ContentTextBlockStyle}" Text="Введите примечание"/>

            <TextBox Style="{StaticResource SingleLineTextBox}" Text="Хорошего дня"/>
        </StackPanel>
        
    </Grid>
</Window>
