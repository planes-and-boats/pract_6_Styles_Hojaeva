<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="12"/>
        <Setter Property="Width" Value="auto"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Value" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource ProgressBarBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ProgressBarForeground}"/>
        
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                <Setter Property="Background" Value="{DynamicResource ProgressBarHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource ProgressBarForegroundEnabled}"/>
                <Setter Property="Background" Value="{DynamicResource ProgressBarEnabled}"/>
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>